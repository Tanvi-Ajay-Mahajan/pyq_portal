# ---------------------------------------------------------------------------
# Server configuration — copy to server/.env and fill in real values.
# Never commit the filled-in .env file.
# ---------------------------------------------------------------------------

# MongoDB connection string (local or MongoDB Atlas)
# local:  mongodb://127.0.0.1:27017/pyq_portal
# atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/pyq_portal
MONGODB_URI=
MONGODB_DB_NAME=pyq_portal

# Secret used to sign JWTs — use a long random string, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# Port for the Express server (must match the deployment port)
PORT=3000
NODE_ENV=development

# Comma-separated list of allowed browser origins. Leave empty to allow all
# (development only). In production set your deployed URL.
CLIENT_ORIGIN=

# First administrator, created by `npm run seed` (required to use the admin dashboard)
ADMIN_NAME=Portal Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Seed the reference data automatically on server start (handy for a fresh DB)
SEED_ON_START=false

# Optional: only needed for the one-time export of the previous Supabase database
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# AI study features (Phase 2). Without GEMINI_API_KEY the AI pages still render
# and clearly report "AI is not configured" instead of returning fake answers.
# Get a free key at https://aistudio.google.com/apikey
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=text-embedding-004

# Generation timeout (ms) and PDF ingestion limits
AI_TIMEOUT_MS=60000
AI_MAX_PDF_MB=15
AI_MAX_PAGES=200
AI_MAX_CHUNKS=400

# Set to true only if the host has OCR tooling available for scanned PDFs
AI_OCR_ENABLED=false
